
# ─── Environment ─────────────────────────────────────────────────────────────
# Required for local/dev-only test endpoints (e.g. POST /billing/test/simulate-renewal).
# Allowed local values: development, local, dev, test.
# Production-like values (production, prod, staging, stage) or leaving this unset
# keeps those endpoints unregistered. Do not set this to a local value in production.
APP_ENVIRONMENT=development

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL where the frontend app is hosted (used for CORS and redirect links)
APP_FRONTEND_URL=http://localhost:5173

# ─── Security / JWT ──────────────────────────────────────────────────────────
# Secret key for signing JWT tokens and mailbox tokens
APP_SECRET_KEY=your-secret-key-here
APP_MAILBOX_SECRET_KEY=your-mailbox-secret-key-here

# Access token lifetime and signing algorithm
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ALGORITHM=HS256

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
# Connection details for the primary Postgres database
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=your-db-password
APP_POSTGRES_DB=lead_management
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
# Cloud Run + Cloud SQL: set the host to the socket directory instead, e.g.
# APP_POSTGRES_HOST=/cloudsql/PROJECT:REGION:INSTANCE

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis is used for caching, task queues, and job results
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_DB=0
# Managed Redis with AUTH + TLS (e.g. Upstash): set both, and use rediss:// below
# APP_REDIS_PASSWORD=
# APP_REDIS_SSL=true
# Redis that requires a client certificate (mutual TLS): PEM file paths, set together.
# On Cloud Run these are Secret Manager secrets mounted as files. CA is optional —
# the system store already trusts public CAs such as Let's Encrypt.
# APP_REDIS_SSL_CERTFILE=/secrets/redis-cert/client.crt
# APP_REDIS_SSL_KEYFILE=/secrets/redis-key/client.key
# APP_REDIS_SSL_CA_CERTS=
APP_REDIS_URL=redis://localhost:6379/0
APP_REDIS_RESULT_URL=redis://localhost:6379/1

# ─── Email Tracking ──────────────────────────────────────────────────────────
# Base URL used to generate open/click tracking links in outgoing emails
APP_EMAIL_TRACKING_BASE_URL=https://your-domain.com

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Used for user login and connecting Gmail mailboxes
APP_GOOGLE_CLIENT_ID=your-google-client-id
APP_GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_GOOGLE_REDIRECT_URI=http://your-domain.com/auth/google/callback
APP_MAILBOX_GOOGLE_REDIRECT_URI=http://your-domain.com/mailboxes/google/callback

# ─── Google Maps & Gemini AI ─────────────────────────────────────────────────
# Google Maps API key for location/company data enrichment
APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Gemini model and API key for AI-powered features (lead gen, chat, etc.)
APP_GEMINI_MODEL=gemini-2.5-flash
APP_GEMINI_API_KEY=your-gemini-api-key

# ─── Admin account (do NOT put credentials here) ──────────────────────────────
# Admin email/password are intentionally NOT read from .env or source code —
# plaintext in either place ends up shared via git, backups, or screenshots.
# Create or promote an admin once per environment with the interactive CLI:
#   cd backend && python -m scripts.create_admin
# Password is typed hidden in the terminal, hashed with bcrypt, and only the
# hash is stored in the database (plaintext cannot be recovered from it).

# ─── SMTP (OTP, contact form, cancellation feedback) ─────────────────────────
# Required for OTP emails, the public contact form, and subscription cancellation
# feedback after the Stripe billing portal. Copy these into backend/.env and fill
# in real values from your mail provider (ZeptoMail, MXRoute, etc.).
APP_SMTP_HOST=smtp.zeptomail.com
APP_SMTP_PORT=587
APP_SMTP_USERNAME=emailapikey
APP_SMTP_PASSWORD=your-smtp-password
APP_SMTP_FROM_EMAIL=noreply@your-domain.com
# Where contact + cancellation messages are delivered (team inbox)
APP_CONTACT_INBOX_EMAIL=mail@example.com

# ─── Brevo (Email Campaigns) ─────────────────────────────────────────────────
# Brevo API key for sending campaign emails; webhook token for validating events
APP_BREVO_API_KEY=your-brevo-api-key
APP_BREVO_WEBHOOK_TOKEN=your-brevo-webhook-token

# ─── Hunter.io (Lead Enrichment) ─────────────────────────────────────────────
# Used to find and verify professional email addresses for leads
APP_HUNTER_API_KEY=your-hunter-api-key

# ─── Stripe (Billing & Subscriptions) ────────────────────────────────────────
# Price IDs for each subscription plan (from Stripe dashboard)
APP_STRIPE_STARTER_PRICE=price_xxx
APP_STRIPE_GROWTH_PRICE=price_xxx
APP_STRIPE_SCALE_PRICE=price_xxx
# Optional: yearly recurring prices (credits = 12 × monthly allowance per renewal). Used when billing_interval=year.
# APP_STRIPE_STARTER_ANNUAL_PRICE=price_xxx
# APP_STRIPE_GROWTH_ANNUAL_PRICE=price_xxx
# APP_STRIPE_SCALE_ANNUAL_PRICE=price_xxx

# Stripe API keys and webhook secret
APP_STRIPE_WEBHOOK_SIGNING_SECRET=whsec_xxx
APP_STRIPE_SECRET_KEY=sk_test_xxx
APP_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── AWS SNS (SES Webhook Notifications) ─────────────────────────────────────
# Comma-separated TopicArns that this server will accept. Required: an empty
# value rejects every SNS webhook (fail closed). Copy the ARN from
# AWS Console → SNS → Topics.
# Example: arn:aws:sns:us-east-1:123456789012:evecta-ses-notifications
APP_SNS_ALLOWED_TOPIC_ARNS=arn:aws:sns:us-east-1:your-account-id:your-topic-name

# Optional — SES v2 API for system mail (Gmail inbox-hover Unsubscribe).
# Set region + IAM keys on staging/production. Region is auto-detected from
# mailbox smtp_host (email-smtp.us-east-1.amazonaws.com) when omitted.
# APP_AWS_SES_REGION=us-east-1
# APP_AWS_ACCESS_KEY_ID=
# APP_AWS_SECRET_ACCESS_KEY=
# Leave SES configuration set unset for campaigns — evecta-config with SES
# subscription management overrides List-Unsubscribe and breaks Gmail hover UI.
# APP_SES_CONFIGURATION_SET=
